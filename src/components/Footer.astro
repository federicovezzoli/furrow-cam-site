---
import { AUTHOR_URL, PRIVACY_URL, REPO_URL } from "../lib/links";
import GitHubIcon from "./GitHubIcon.astro";
---

<footer class="border-t border-line px-4 py-8">
  <div class="label mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 text-faint">
    <p>
      © 2026 <a href={AUTHOR_URL} class="hover:text-fg">Federico Vezzoli</a>
    </p>
    <nav class="flex gap-5">
      <a href={REPO_URL} class="flex items-center gap-1.5 hover:text-fg"><GitHubIcon class="size-3.5" />GitHub</a>
      <a href={PRIVACY_URL} class="hover:text-fg">Privacy</a>
    </nav>
  </div>
</footer>
