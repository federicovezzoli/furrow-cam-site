---
import { ISSUES_URL, REPO_URL } from "../lib/links";
import GitHubIcon from "./GitHubIcon.astro";
---

<section>
  <div class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-40">
    <p data-scramble class="text-xs tracking-widest text-cut uppercase">OP 08 — Open source, MIT-licensed</p>
    <h2 data-scrub-words class="mt-6 max-w-5xl text-statement font-semibold">
      Every line of code and every design decision is public.
    </h2>

    <ul data-stagger class="mt-16 grid gap-px border border-line bg-line md:grid-cols-3">
      <li class="bg-bg p-6">
        <span class="text-cut" aria-hidden="true">→</span>
        <p class="mt-6">
          Try it on your machine and{" "}
          <a href={ISSUES_URL} class="underline underline-offset-4 hover:text-cut">report</a> anything that cuts wrong
          or is confusing, from the app's own bug report button.
        </p>
      </li>
      <li class="bg-bg p-6">
        <span class="text-cut" aria-hidden="true">→</span>
        <p class="mt-6">
          CNC not in the presets?{" "}
          <a href={ISSUES_URL} class="underline underline-offset-4 hover:text-cut">Propose it</a>, linking the maker's
          documentation for each spec.
        </p>
      </li>
      <li class="bg-bg p-6">
        <span class="text-cut" aria-hidden="true">→</span>
        <p class="mt-6">
          Read and discuss the product requirements and architecture decisions on{" "}
          <a href={REPO_URL} class="underline underline-offset-4 hover:text-cut">GitHub</a>.
        </p>
      </li>
    </ul>

    <a
      href={REPO_URL}
      class="mt-10 inline-flex items-center gap-3 border border-fg/25 px-5 py-3.5 transition-colors hover:border-fg"
      ><GitHubIcon />Star it on GitHub</a
    >
  </div>
</section>
