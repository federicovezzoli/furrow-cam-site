---
import { APP_URL, REPO_URL } from "../lib/links";
import GitHubIcon from "./GitHubIcon.astro";
---

<header class="sticky top-0 z-50 px-4 pt-3 md:pt-4">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 border border-line bg-raised/80 p-2 backdrop-blur-md">
    <a href="/" class="flex items-center gap-2.5 pl-1.5 font-display text-lg font-semibold tracking-[-0.03em]">
      <span class="size-2.5 bg-signal" aria-hidden="true"></span>Furrow CAM
    </a>
    <nav class="label flex items-center gap-2">
      <a href="#download" class="chip hidden sm:inline-flex">Download</a>
      <a href={REPO_URL} class="chip"><GitHubIcon class="size-3.5" /><span class="hidden sm:inline">GitHub</span></a>
      <a href={APP_URL} class="bg-accent px-3 py-[calc(0.375rem+1px)] text-accent-fg transition-opacity hover:opacity-85">Open the app</a>
    </nav>
  </div>
</header>
