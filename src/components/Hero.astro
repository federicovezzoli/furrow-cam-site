---
import { APP_URL, DESKTOP_DOWNLOADS, RELEASES_URL, REPO_URL } from "../lib/links";
import GitHubIcon from "./GitHubIcon.astro";
---

<section class="relative overflow-hidden border-b border-line">
  <video
    src="/furrow-stl-demo-161026.mp4"
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  ></video>
  <!-- Solid behind the text, fading out to the right so the demo stays visible. -->
  <div class="absolute inset-0 bg-bg/80 md:bg-transparent md:bg-linear-to-r md:from-bg/100 md:from-35% md:to-bg/20"></div>

  <div class="relative mx-auto max-w-5xl px-6 py-24 md:py-36">
    <a href={RELEASES_URL} class="inline-block border border-line px-2 py-0.5 text-xs text-muted hover:text-fg">
      Alpha · open source
    </a>
    <h1 class="mt-6 text-3xl font-semibold leading-tight tracking-tight md:text-5xl">
      2.5D CAM for CNC routers,<br /> in your browser.
    </h1>
    <p class="mt-6 max-w-xl text-base text-muted">
      Import an SVG, DXF or STL, set up profile, pocket, drill, engrave, V-carve and 3D relief
      operations, preview every cut, and export G-code for GRBL-compatible machines. No install and no
      sign-up to try it, free and MIT-licensed.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={APP_URL} class="bg-accent px-4 py-2.5 text-accent-fg hover:opacity-90">Open the app</a>
      <a id="desktop-download" href="#download" class="border border-line bg-bg px-4 py-2.5 hover:bg-subtle">Download for desktop</a>
      <a href={REPO_URL} class="flex items-center gap-2 border border-line px-4 py-2.5 hover:bg-subtle"><GitHubIcon />View on GitHub</a>
    </div>
    <p class="mt-4 text-xs text-muted">
      Desktop app for macOS, Windows and Linux ·{" "}
      <a href="#download" class="underline underline-offset-4 hover:text-fg">all downloads</a>
    </p>
  </div>
</section>

<!-- Points the desktop button at the installer for the visitor's system. Without JavaScript, or on
     a phone, it keeps leading to the download section. -->
<script is:inline define:vars={{ downloads: DESKTOP_DOWNLOADS }}>
  (async () => {
    const button = document.getElementById("desktop-download");
    const ua = navigator.userAgent;
    const uaData = navigator.userAgentData;
    const platform = uaData?.platform || ua;
    // iPadOS reports itself as a Mac; touch support gives it away.
    if (/Android|iPhone|iPad/.test(ua) || (/Mac/.test(ua) && navigator.maxTouchPoints > 1)) return;

    let pick;
    if (/win/i.test(platform)) pick = ["Windows", downloads.winX64];
    else if (/mac/i.test(platform)) {
      // Only Chromium tells the architecture; elsewhere assume Apple Silicon, named in the label.
      const arch = await uaData?.getHighEntropyValues(["architecture"]).then((v) => v.architecture, () => undefined);
      pick = arch === "x86" ? ["macOS (Intel)", downloads.macX64] : ["macOS (Apple Silicon)", downloads.macArm64];
    } else if (/linux/i.test(platform)) pick = ["Linux", downloads.linuxAppImage];
    if (!pick) return;

    button.href = pick[1];
    button.textContent = `Download for ${pick[0]}`;
  })();
</script>
