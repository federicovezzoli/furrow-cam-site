---
const presets = [
  { maker: "V1 Engineering", model: "LowRider v4" },
  { maker: "V1 Engineering", model: "MPCNC Primo" },
  { maker: "Maslow CNC", model: "Maslow 4" },
  { maker: "Sienci Labs", model: "LongMill MK2" },
  { maker: "SainSmart", model: "Genmitsu 3018" },
];
---

<section class="border-y border-line bg-subtle">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-10 md:py-28">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p data-scramble class="text-xs tracking-widest text-cut uppercase">OP 05 — Machines</p>
        <h2 data-split class="mt-4 text-h2 font-semibold">Ready for your machine</h2>
      </div>
      <p data-fade class="max-w-md text-muted">
        Start from a preset for a popular hobby router, with every value taken from the maker's
        documentation, or set up any GRBL-compatible router in a minute.
      </p>
    </div>

    <ul data-stagger class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        presets.map((p, i) => (
          <li class="group flex min-h-36 flex-col justify-between gap-6 bg-bg p-6 transition-colors hover:bg-subtle">
            <span class="flex justify-between text-xs text-muted">
              {p.maker}
              <span class="tabular-nums">T{i + 1}</span>
            </span>
            <span class="text-2xl font-semibold tracking-tight">{p.model}</span>
          </li>
        ))
      }
      <li class="flex min-h-36 flex-col justify-between gap-6 bg-cut p-6 text-cut-fg">
        <span class="text-xs">Any controller running</span>
        <span class="text-2xl font-semibold tracking-tight">GRBL, grblHAL or FluidNC</span>
      </li>
    </ul>
  </div>
</section>
